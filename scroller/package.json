    "build:watch": "ng build scroller --watch"
  },
  "peerDependencies": {
    "@angular/common": ">=17.0.0",
    "@angular/core": ">=17.0.0",
    "vscroll": "1.7.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.1.3",
    "@angular/cli": "^21.1.3",
    "@angular/compiler": "^21.1.3",
    "ng-packagr": "^21.1.0",
    "typescript": "5.9.3"
  }
}