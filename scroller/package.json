{
  "name": "ngx-ui-scroll",
  "description": "Virtual scrolling library for Angular applications",
  "version": "4.1.0",
  "license": "MIT",
  "author": "Denis Hilt <dhilt.public@gmail.com>",
  "homepage": "https://github.com/dhilt/ngx-ui-scroll",
  "repository": {
    "type": "git",
    "url": "https://github.com/dhilt/ngx-ui-scroll.git"
  },
  "scripts": {
    "copy:docs": "cp ../README.md ../LICENSE ../dist/scroller",
    "lint": "tsc -p tsconfig.json --noEmit",
